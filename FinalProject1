workouts = []

def menu():
  print("Workout Tracker")
  print("---------------")
  print("1. Add Workout")
  print("2. View Workouts")
  print("3. Find Workouts")
  print("4. Quit")

def addWorkout():
    name = input("Enter Workout Name")
    workouts.append()
    print("Workout Added!")

def viewWorkouts():
    for workout in workouts:
        print(workout)

def findWorkout():
    name = input("Enter Workout Name That You Are Looking To Find")
    for workout in workouts:
        if name in workout:
            print("Workout Found", workout)

def main():
    selection = " "
  
    while selection != "4":
        menu()
        selection = input("Make A Selection")

        if selection == "1":
            addWorkout()
        elif selection == "2":
            viewWorkouts()
        elif selection == "3":
            findWorkout()
        elif selection == "4":
            print("Goodbye!")
        else:
            print("Your Selection Is Invalid")
   
main()
