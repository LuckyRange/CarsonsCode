class Student:

  def __init__(self, first, last, districtCode, enrolledCredits):
      self.first = first
      self.last = last
      self.districtCode = districtCode
      self.enrolledCredits = enrolledCredits

  def tuitionOwed(self):
      if self.districtCode == 'I':
          return self.enrolledCredits * 250
      else:
          return self.enrolledCredits * 500

student_1 = Student('Jon', 'Jones', 'I', 15)
student_2 = Student('Daniel', 'Cormier', 'O', 12)

print(student_1.tuitionOwed())
print(student_2.tuitionOwed())
