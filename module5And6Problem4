principal = input("Enter Principal Amount")
years = input("Enter Years To Maturity Date")

if principal > 100000 and years == 5:
interestRate = .06
elif principal >= 50000 and principal <= 100000 and years == 10:
interestRate = .05
elif principal >= 50000 and principal <= 100000 and years == 5:
interestRate = .04
else:
interestRate = .02

interest = principal * interestRate

print(f"Principal: $(principal: .2f)")
print(f"Interest Rate: interestRate: .2%f)")
print(f"First Year Interest Amount: $(interest: .2f)")

